# Required in production: long random string, e.g. `openssl rand -base64 32`
AUTH_SECRET=change-me
# MySQL connection (Aiven: copy the Service URI; ?ssl-mode=REQUIRED is fine).
# For VERIFY_CA / VERIFY_IDENTITY also set DATABASE_CA to the host's CA certificate (PEM, \n for newlines).
DATABASE_URL=mysql://deutsch:deutsch@127.0.0.1:3306/deutsch
